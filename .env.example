# ==========================================
# STREAM ENVIRONMENT CONFIGURATION
# ==========================================
# For Local Development: Copy this file to .env and insert your real keys.
# For Render Deployment: Add these keys and values under:
# Render Dashboard -> Your Service -> Environment (or Secret Files -> .env)

# Third-Party Movie & Content APIs
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
VITE_WATCHMODE_API_KEY=your_watchmode_api_key_here
VITE_OMDB_API_KEY=your_omdb_api_key_here
VITE_NEWS_API_KEY=your_news_api_key_here

# Supabase Authentication & Database (Optional / For live auth & synced favorites)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
